# Hosted-only cars and circuits: served on librecorsa.org from the noryx-assets R2 bucket
# (npm run upload-hosted), never committed. The repository carries RISE Motordrome and the 2026 prototype car
# (src/lib/hosted-content.ts)
/public/tracks/*
!/public/tracks/rwanda_official/
!/public/tracks/rwanda_official_short/
!/public/tracks/index.json
# RISE's KTX2 model for phones (src/lib/ktx2-models.ts) is hosted like the other circuits
/public/tracks/rwanda_official/*.ktx2.*.glb
/public/cars/*
!/public/cars/f12026/
!/public/cars/classic-coupe/
!/public/cars/cartoon-sports-car/
/public/gt3/
